---
import type { ContentView } from '@kreiz/core/content';
import {
  breadcrumbJsonLd,
  jsonLdScriptTag,
  resolveContentSeo,
  seoHeadTags,
  articleJsonLd,
} from '@kreiz/core/seo';
import type { ArticleData } from '../content-types/article.js';
import { seoSite } from '../seo.js';
import CoverPicture from './CoverPicture.astro';
import '../styles/global.css';

/**
 * Template public de l'Article — **fourni par le projet**, rendu à
 * l'identique par la preview SSR du Core (`/admin/preview/[id]`) et par la
 * page publique `/articles/[slug]` (mission §21/§23). Le template reçoit
 * des données structurées typées, jamais du layout : toute la mise en page
 * appartient au projet (principe §1).
 *
 * Slice 5 : la couverture (`view.cover`) est rendue en `<picture>`
 * responsive via le composant local `CoverPicture` (helpers `@kreiz/core/media`).
 *
 * Slice 9 : la head publique est **résolue** (`resolveContentSeo`) et rendue
 * par le Core (`seoHeadTags`) — canonical, robots, Open Graph, Twitter —
 * complétée par du JSON-LD construit avec les builders typés. Aucune balise
 * meta n'est écrite à la main depuis du HTML arbitraire. En preview, le
 * Core impose `noindex` à la vue : la même résolution produit une head non
 * indexable, sans canonical.
 */
interface Props {
  view: ContentView<ArticleData>;
}

const { view } = Astro.props;
const resolvedSeo = resolveContentSeo(seoSite, view, {
  ogType: 'article',
  description: view.data.excerpt,
});
const articleLd = articleJsonLd({
  headline: view.title,
  url: resolvedSeo.canonical,
  datePublished: view.publishedAt ?? view.createdAt,
  authorName: view.data.author,
  description: resolvedSeo.description,
  imageUrl: resolvedSeo.og.image?.url,
  publisherName: seoSite.organization?.name ?? seoSite.siteName,
});
const breadcrumbLd = breadcrumbJsonLd([
  { name: seoSite.siteName, url: `${seoSite.siteUrl}/` },
  { name: view.title, url: resolvedSeo.canonical },
]);
const publishedDate = view.publishedAt
  ? view.publishedAt.toLocaleDateString('fr-FR', { dateStyle: 'long' })
  : null;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={seoHeadTags(resolvedSeo)} />
    <Fragment set:html={jsonLdScriptTag(articleLd)} />
    <Fragment set:html={jsonLdScriptTag(breadcrumbLd)} />
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
    <main class="mx-auto max-w-2xl px-6 py-20">
      <article>
        <header class="border-b border-neutral-800 pb-8">
          <p class="text-xs font-medium uppercase tracking-widest text-neutral-400">
            Article
            {!publishedDate && <span class="text-amber-400">— brouillon (preview)</span>}
          </p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight">{view.title}</h1>
          <p class="mt-4 text-lg leading-relaxed text-neutral-300">{view.data.excerpt}</p>
          <p class="mt-6 text-sm text-neutral-400">
            Par {view.data.author}{publishedDate ? ` · ${publishedDate}` : ''}
          </p>
        </header>

        {view.cover && <CoverPicture cover={view.cover} />}

        {/* Rich text (slice 6) : `view.richText.body.html` provient
        exclusivement du renderer déterministe du Core (`@kreiz/core/rich-text`)
        — texte intégralement échappé, tags/attributs whitelistés, médias
        rendus via le pipeline slice 5. Aucun HTML de source inconnue. */}
        <div class="mt-8 space-y-4 leading-relaxed text-neutral-200" set:html={view.richText.body?.html} />
      </article>

      <footer class="mt-16 border-t border-neutral-800 pt-6 text-sm text-neutral-500">
        <a href="/" class="transition hover:text-neutral-300">← Kreiz, application de démonstration</a>
      </footer>
    </main>
  </body>
</html>
