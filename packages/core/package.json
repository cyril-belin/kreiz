{
  "name": "@kreiz/core",
  "version": "0.1.0",
  "description": "Kreiz — Astro Editorial Core : moteur éditorial générique (contenus, médias, publication, admin privé).",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cyril-belin/kreiz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyril-belin/kreiz.git",
    "directory": "packages/core"
  },
