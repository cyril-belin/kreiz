---
export const prerender = false;

import AdminShell from '../../components/AdminShell.astro';
import ContentFormFields from '../../components/ContentFormFields.astro';
import CoverPicker from '../../components/CoverPicker.astro';
import OgImagePicker from '../../components/OgImagePicker.astro';
import MessagePanel from '../../components/MessagePanel.astro';
import {
  ADMIN_CONTENT_INDEX_PATH,
  ADMIN_LOGIN_PATH,
  ADMIN_REBUILD_PATH,
  adminContentDeletePath,
  adminContentPublishPath,
  adminContentTypePath,
  adminContentUnpublishPath,
  adminPreviewPath,
} from '../../../http/admin-routes.js';
import { CSRF_FORM_FIELD, verifySessionCsrfToken } from '../../../http/csrf.js';
import { parseContentForm, type FormFieldValue } from '../../../http/content-form.js';
import { isTrustedSameSiteMutation } from '../../../http/mutations.js';
import { publicPath } from '../../../domain/content/redirect-engine.js';
import { hasUnpublishedChanges } from '../../../domain/content/publication-state.js';
import {
  authenticateContentPage,
  formValuesFromData,
  mergeContentFieldErrors,
} from '../../lib/content-page.js';
import { readyPickerItems } from '../../lib/media-picker.js';
import { collectRichTextMediaIds } from '../../../domain/content/view-model.js';

const access = await authenticateContentPage(Astro);
if (access.kind === 'unauthenticated') {
  return Astro.redirect(ADMIN_LOGIN_PATH, 302);
}

const typeKey = Astro.params.type ?? '';
const entryId = Astro.params.id ?? '';
const declaration = access.runtime.content.registry.findByKey(typeKey);

// Chargement (GET comme POST) : contenu non supprimé, déclaration résolue
// depuis l'entrée. L'isolation des types est vérifiée ici : un Article n'est
// jamais éditable via une route Guide (mission §35) — 404, sans détail.
type LoadedEntry = Awaited<ReturnType<typeof access.runtime.content.getContentForEdit>>;
let loaded: LoadedEntry | null = null;
let errorStatus: number | null = null;
let errorKind: 'not-found' | 'deleted' | null = null;

if (!declaration) {
  errorStatus = 404;
} else {
  try {
    const result = await access.runtime.content.getContentForEdit(entryId);
    if (result.entry.contentType !== declaration.key) {
      // Mauvais type dans l'URL : même réponse qu'un contenu absent.
      errorStatus = 404;
      errorKind = 'not-found';
    } else {
      loaded = result;
    }
  } catch (error) {
    const name = (error as { name?: string }).name;
    if (name === 'ContentDeletedError') {
      errorStatus = 410;
      errorKind = 'deleted';
    } else {
      errorStatus = 404;
      errorKind = 'not-found';
    }
  }
}
if (errorStatus !== null) {
  Astro.response.status = errorStatus;
}

// État de publication (mission §28) : statuts clairs, wording honnête —
// un Save sur un publié ne met jamais le site à jour, l'UI doit le dire.
const entry = loaded?.entry ?? null;
const isPublished = entry?.status === 'published';
const hasEverBeenPublished = entry?.publishedSlug !== null && entry?.publishedSlug !== undefined;
const unpublishedChanges = entry ? hasUnpublishedChanges(entry) : false;
const publishedPath =
  entry?.publishedSlug != null && declaration
    ? publicPath(declaration.routeNamespace, entry.publishedSlug)
    : null;
const dateFormatter = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium', timeStyle: 'short' });

// État du formulaire (re-rendu fidèle en cas d'erreur de validation).
let formTitle = loaded?.entry.title ?? '';
let formSlug = loaded?.entry.slug ?? '';
let formCoverMediaId: string | null = loaded?.entry.coverMediaId ?? null;
/** SEO éditorial courant — valeur initiale = état stocké, puis saisie (re-rendu fidèle). */
let formSeo: Record<string, unknown> = { ...loaded?.entry.seo };
let fieldValues: Record<string, FormFieldValue> = formValuesFromData(
  declaration?.fields ?? {},
  loaded?.entry.data ?? {},
);
let fieldErrors: Record<string, string> = {};
let formError: string | null = null;

// Pickers de couverture et rich text : médias `ready` uniquement (mission
// §29, slice 6 §11). Les items portent la miniature pour le picker éditeur.
const readyMedia = access.runtime.mediaAdmin
  ? (await access.runtime.mediaAdmin.listReady()).map((media) => ({ id: media.id, alt: media.altText }))
  : [];
const pickerItems = readyPickerItems(
  access.runtime.mediaAdmin ? await access.runtime.mediaAdmin.listReady() : [],
  access.runtime.mediaPublicBaseUrl,
);

// Miniatures additionnelles pour les médias référencés par le document mais
// hors de la fenêtre du listing `ready` (au-delà de 200) : l'éditeur doit
// toujours pouvoir afficher le document courant.
const referencedIds = collectRichTextMediaIds(declaration?.fields ?? {}, loaded?.entry.data ?? {});
for (const id of referencedIds) {
  if (pickerItems.some((item) => item.id === id)) continue;
  const row = access.runtime.mediaAdmin ? await access.runtime.mediaAdmin.findById(id) : null;
  const [item] = readyPickerItems(row ? [row] : [], access.runtime.mediaPublicBaseUrl);
  if (item) pickerItems.push(item);
}

/** Miniature de la couverture courante — plus petite variante WebP (serveur). */
function coverThumbnail(
  cover: { variants: ReadonlyArray<{ url: string; format: string }> } | null | undefined,
): string | null {
  if (!cover) return null;
  const webp = cover.variants.filter((variant) => variant.format === 'image/webp');
  return (webp[0] ?? cover.variants[0])?.url ?? null;
}

// Bandeaux de résultat (redirections 303 des mutations POST).
const saved = Astro.url.searchParams.get('saved') === '1';
const published = Astro.url.searchParams.get('published') === '1';
const unpublished = Astro.url.searchParams.get('unpublished') === '1';
const rebuildState = Astro.url.searchParams.get('rebuild');
const publishError = Astro.url.searchParams.get('publish_error');

if (loaded && Astro.request.method === 'POST') {
  // Mutations : même protection que le slice 2 (same-site + CSRF lié à la
  // session), vérifiées avant toute action — jamais un deuxième système.
  if (!isTrustedSameSiteMutation(Astro.request)) {
    formError = 'Requête refusée.';
    Astro.response.status = 403;
  } else {
    let formData: FormData;
    let csrfSubmitted: FormDataEntryValue | null = null;
    try {
      formData = await Astro.request.formData();
      csrfSubmitted = formData.get(CSRF_FORM_FIELD);
    } catch {
      formError = 'Requête refusée.';
      Astro.response.status = 403;
    }

    if (
      formError === null &&
      !verifySessionCsrfToken(access.sessionToken, typeof csrfSubmitted === 'string' ? csrfSubmitted : null)
    ) {
      formError = 'Requête refusée.';
      Astro.response.status = 403;
    }

    if (formError === null) {
      const parsed = parseContentForm(declaration!, formData);
      formTitle = parsed.title;
      formSlug = parsed.slug;
      formCoverMediaId = parsed.coverMediaId;
      formSeo = parsed.seo;
      fieldValues = parsed.values;
      const outcome = await access.runtime.content.updateDraft({
        entryId,
        title: parsed.title,
        slug: parsed.slug.length > 0 ? parsed.slug : undefined,
        data: parsed.data,
        coverMediaId: parsed.coverMediaId,
        seo: parsed.seo,
        actorAdminId: access.access.admin.id,
      });
      if (outcome.kind === 'updated') {
        // Retour sur l'édition avec le bandeau de confirmation — pas de
        // re-rendu POST (F5 sans reproposer la soumission).
        const redirectUrl = new URL(Astro.request.url);
        redirectUrl.search = '?saved=1';
        return Astro.redirect(redirectUrl.pathname + redirectUrl.search, 303);
      }
      fieldErrors = mergeContentFieldErrors(parsed.errors, outcome.errors);
      Astro.response.status = 400;
    }
  }
}
---

<AdminShell
  title={loaded ? loaded.entry.title : 'Contenu'}
  admin={access.access.admin}
  csrfToken={access.access.csrfToken}
  currentPath={Astro.url.pathname}
>
  {
    errorKind === 'not-found' ? (
      <MessagePanel
        title="Contenu introuvable"
        description="Ce contenu n'existe pas ou ce type n'est pas déclaré par le projet."
        backHref={declaration ? adminContentTypePath(declaration.key) : ADMIN_CONTENT_INDEX_PATH}
        backLabel="Retour au contenu"
      />
    ) : errorKind === 'deleted' ? (
      <MessagePanel
        title="Contenu supprimé"
        description="Ce contenu a été supprimé."
        backHref={declaration ? adminContentTypePath(declaration.key) : ADMIN_CONTENT_INDEX_PATH}
        backLabel="Retour au contenu"
      />
    ) : (
      loaded &&
      entry &&
      declaration && (
        <>
          {published && !publishError && (
            <div class:list={['kz-banner', rebuildState === 'failed' ? 'kz-banner--warning' : 'kz-banner--success']} role="status">
              {rebuildState === 'ok' && (
                <>Contenu publié — reconstruction du site demandée. La nouvelle version apparaîtra en ligne dès la fin du build.</>
              )}
              {rebuildState === 'unconfigured' && (
                <>Contenu publié en base — aucun moteur de rebuild n'est configuré : le site public ne sera pas reconstruit automatiquement.</>
              )}
              {rebuildState === 'failed' && (
                <>Contenu publié en base, mais la reconstruction a échoué : le site public reste inchangé (dernier site valide conservé). Vous pouvez relancer le déploiement.</>
              )}
            </div>
          )}
          {unpublished && (
            <div class:list={['kz-banner', rebuildState === 'failed' ? 'kz-banner--warning' : 'kz-banner--success']} role="status">
              {rebuildState === 'ok' && (
                <>Contenu dépublié — la page publique sera retirée du site à la prochaine reconstruction.</>
              )}
              {rebuildState === 'unconfigured' && (
                <>Contenu dépublié en base — aucun moteur de rebuild n'est configuré : la page publique reste en ligne jusqu'à la prochaine reconstruction.</>
              )}
              {rebuildState === 'failed' && (
                <>Contenu dépublié en base, mais la reconstruction a échoué : le site public reste inchangé. Vous pouvez relancer le déploiement.</>
              )}
            </div>
          )}
          {saved && (
            <div class="kz-banner kz-banner--success" role="status">
              {isPublished
                ? 'Modifications enregistrées — non publiées. La version publique reste en ligne jusqu’à la prochaine publication.'
                : 'Brouillon enregistré.'}
            </div>
          )}
          {/* Reconstruction seule (retry depuis ce même écran) — sans published/unpublished. */}
          {!published && !unpublished && rebuildState && (
            <div class:list={['kz-banner', rebuildState === 'ok' ? 'kz-banner--success' : 'kz-banner--warning']} role="status">
              {rebuildState === 'ok' && 'Déploiement relancé — reconstruction du site demandée.'}
              {rebuildState === 'failed' && 'La reconstruction a encore échoué : le dernier site valide reste en ligne.'}
              {rebuildState === 'unconfigured' && 'Aucun moteur de rebuild n’est configuré : la relance n’a rien déclenché.'}
            </div>
          )}
          {publishError === 'validation' && (
            <div class="kz-banner kz-banner--warning" role="alert">
              Publication impossible : le contenu actuel est invalide. Corrigez les champs puis republiez.
            </div>
          )}
          {publishError === 'conflict' && (
            <div class="kz-banner kz-banner--warning" role="alert">
              Publication impossible : l'ancienne adresse publique est actuellement utilisée par un autre contenu. Modifiez le slug de l'un des deux contenus.
            </div>
          )}

          {/* Panneau d'état de publication — statut clair, wording honnête (mission §28). */}
          <section class="kz-panel kz-publication-state" aria-label="État de publication">
            <div class="kz-publication-state__row">
              <span
                class:list={['kz-badge', isPublished ? 'kz-badge--published' : 'kz-badge--draft']}
              >
                {isPublished ? 'Publié' : hasEverBeenPublished ? 'Dépublié' : 'Brouillon'}
              </span>
              <span class="kz-publication-state__text">
                {!hasEverBeenPublished && (
                  <>Ce contenu n'est pas encore visible sur le site public. Publiez-le pour générer sa page.</>
                )}
                {hasEverBeenPublished && isPublished && !unpublishedChanges && (
                  <>
                    Adresse publique : <code class="kz-slug">{publishedPath}</code>
                    {entry.publishedAt && (
                      <span class="kz-publication-state__meta">
                        {' '}— première publication : {dateFormatter.format(entry.publishedAt)}
                      </span>
                    )}
                  </>
                )}
                {hasEverBeenPublished && isPublished && unpublishedChanges && (
                  <>
                    Modifications non publiées — la version publique{' '}
                    <code class="kz-slug">{publishedPath}</code> reste en ligne jusqu'à la prochaine
                    publication{entry.slug !== entry.publishedSlug && (
                      <> (nouvelle adresse : <code class="kz-slug">/{declaration.routeNamespace}/{entry.slug}</code>)</>
                    )}.
                  </>
                )}
                {hasEverBeenPublished && !isPublished && (
                  <>
                    Ce contenu est retiré du site public à la prochaine reconstruction
                    {publishedPath && (
                      <> (dernière adresse publique : <code class="kz-slug">{publishedPath}</code>)</>
                    )}
                    . Republiez pour le remettre en ligne.
                  </>
                )}
              </span>
            </div>
          </section>

          <div class="kz-page-actions kz-page-actions--spread">
            <a class="kz-button kz-button--ghost" href={adminPreviewPath(entryId)}>
              Preview
            </a>
            <div class="kz-page-actions">
              <form method="post" action={adminContentPublishPath(declaration.key, entryId)}>
                <input type="hidden" name={CSRF_FORM_FIELD} value={access.access.csrfToken} />
                <button class="kz-button" type="submit">
                  {isPublished ? 'Publier les modifications' : 'Publier'}
                </button>
              </form>
              {isPublished && (
                <form method="post" action={adminContentUnpublishPath(declaration.key, entryId)}>
                  <input type="hidden" name={CSRF_FORM_FIELD} value={access.access.csrfToken} />
                  <button class="kz-button kz-button--ghost" type="submit">Dépublier</button>
                </form>
              )}
              <form method="post" action={adminContentDeletePath(declaration.key, entryId)}>
                <input type="hidden" name={CSRF_FORM_FIELD} value={access.access.csrfToken} />
                <button class="kz-button kz-button--danger" type="submit">Supprimer</button>
              </form>
            </div>
          </div>

          <form class="kz-form" method="post" novalidate>
            {formError && (
              <p class="kz-alert" role="alert">
                {formError}
              </p>
            )}
            <input type="hidden" name={CSRF_FORM_FIELD} value={access.access.csrfToken} />

            <div class="kz-field">
              <label class="kz-label" for="kz-title">
                Titre<span class="kz-required" aria-hidden="true"> *</span>
              </label>
              <input
                class="kz-input"
                type="text"
                id="kz-title"
                name="title"
                value={formTitle}
                required
                aria-invalid={fieldErrors.title ? 'true' : undefined}
              />
              {fieldErrors.title && <p class="kz-field-error" role="alert">{fieldErrors.title}</p>}
            </div>

            <div class="kz-field">
              <label class="kz-label" for="kz-slug">Slug</label>
              <p class="kz-help">
                Adresse publique : /{declaration.routeNamespace}/{formSlug || '…'} — lettres minuscules, chiffres et tirets.
                {isPublished && ' Changer le slug d’un contenu publié créera une redirection 301 de l’ancienne adresse à la prochaine publication.'}
              </p>
              <input
                class="kz-input"
                type="text"
                id="kz-slug"
                name="slug"
                value={formSlug}
                autocomplete="off"
                aria-invalid={fieldErrors.slug ? 'true' : undefined}
              />
              {fieldErrors.slug && <p class="kz-field-error" role="alert">{fieldErrors.slug}</p>}
            </div>

            <ContentFormFields
              fields={declaration.fields}
              values={fieldValues}
              errors={fieldErrors}
              pickerItems={pickerItems}
            />

            <CoverPicker
              readyMedia={readyMedia}
              selectedMediaId={formCoverMediaId}
              selectedThumbnailUrl={coverThumbnail(loaded.view.cover)}
              error={fieldErrors.cover}
            />

            <fieldset class="kz-fieldset">
              <legend class="kz-legend">SEO</legend>
              <p class="kz-help">
                Optionnel — par défaut, le titre du contenu et sa couverture suffisent. Ces
                réglages ne modifient le site public qu'à la prochaine publication.
              </p>

              <div class="kz-field">
                <label class="kz-label" for="kz-seo-title">Titre SEO</label>
                <p class="kz-help">Sinon : titre du contenu, habillé du nom du site.</p>
                <input
                  class="kz-input"
                  type="text"
                  id="kz-seo-title"
                  name="seo_title"
                  value={typeof formSeo.title === 'string' ? formSeo.title : ''}
                  maxlength={120}
                  aria-invalid={fieldErrors.seo_title ? 'true' : undefined}
                />
                {fieldErrors.seo_title && <p class="kz-field-error" role="alert">{fieldErrors.seo_title}</p>}
              </div>

              <div class="kz-field">
                <label class="kz-label" for="kz-seo-description">Meta description</label>
                <p class="kz-help">Sinon : accroche ou début du texte. Texte pur, ~2 phrases.</p>
                <textarea
                  class="kz-input"
                  id="kz-seo-description"
                  name="seo_description"
                  rows="3"
                  maxlength={300}
                  aria-invalid={fieldErrors.seo_description ? 'true' : undefined}>{typeof formSeo.description === 'string' ? formSeo.description : ''}</textarea>
                {fieldErrors.seo_description && <p class="kz-field-error" role="alert">{fieldErrors.seo_description}</p>}
              </div>

              <div class="kz-field">
                <label class="kz-label" for="kz-seo-canonical">URL canonique (override)</label>
                <p class="kz-help">
                  Réservé aux cas particuliers — par défaut, l'adresse publique du contenu est
                  canonique. Chemin interne (« /chemin ») ou URL du même domaine.
                </p>
                <input
                  class="kz-input"
                  type="text"
                  id="kz-seo-canonical"
                  name="seo_canonical"
                  value={typeof formSeo.canonicalOverride === 'string' ? formSeo.canonicalOverride : ''}
                  maxlength={2048}
                  autocomplete="off"
                  aria-invalid={fieldErrors.seo_canonical ? 'true' : undefined}
                />
                {fieldErrors.seo_canonical && <p class="kz-field-error" role="alert">{fieldErrors.seo_canonical}</p>}
              </div>

              <div class="kz-field kz-field--checkbox">
                <input
                  type="checkbox"
                  id="kz-seo-noindex"
                  name="seo_noindex"
                  checked={formSeo.noindex === true}
                />
                <label class="kz-label" for="kz-seo-noindex">
                  Exclure des moteurs de recherche (noindex)
                </label>
              </div>

              <OgImagePicker
                readyMedia={readyMedia}
                selectedMediaId={typeof formSeo.ogImageMediaId === 'string' ? formSeo.ogImageMediaId : null}
                selectedThumbnailUrl={coverThumbnail(loaded.view.seoImage)}
                error={fieldErrors.seo_og_image}
              />

              <div class="kz-field">
                <label class="kz-label" for="kz-seo-og-title">Titre Open Graph (override)</label>
                <p class="kz-help">Sinon : titre résolu ci-dessus.</p>
                <input
                  class="kz-input"
                  type="text"
                  id="kz-seo-og-title"
                  name="seo_og_title"
                  value={typeof formSeo.ogTitle === 'string' ? formSeo.ogTitle : ''}
                  maxlength={120}
                  aria-invalid={fieldErrors.seo_og_title ? 'true' : undefined}
                />
                {fieldErrors.seo_og_title && <p class="kz-field-error" role="alert">{fieldErrors.seo_og_title}</p>}
              </div>

              <div class="kz-field">
                <label class="kz-label" for="kz-seo-og-description">Description Open Graph (override)</label>
                <p class="kz-help">Sinon : description résolue ci-dessus.</p>
                <textarea
                  class="kz-input"
                  id="kz-seo-og-description"
                  name="seo_og_description"
                  rows="3"
                  maxlength={300}
                  aria-invalid={fieldErrors.seo_og_description ? 'true' : undefined}>{typeof formSeo.ogDescription === 'string' ? formSeo.ogDescription : ''}</textarea>
                {fieldErrors.seo_og_description && <p class="kz-field-error" role="alert">{fieldErrors.seo_og_description}</p>}
              </div>
            </fieldset>

            {fieldErrors['_form'] && <p class="kz-alert" role="alert">{fieldErrors['_form']}</p>}

            <div class="kz-form-actions">
              <a class="kz-button kz-button--ghost" href={adminContentTypePath(declaration.key)}>
                Retour au listing
              </a>
              <button class="kz-button" type="submit">
                {isPublished ? 'Enregistrer (sans publier)' : 'Enregistrer le brouillon'}
              </button>
            </div>
            {isPublished && (
              <p class="kz-help">
                L'enregistrement ne modifie pas le site public — seulement la publication le met à jour.
              </p>
            )}
          </form>

          {rebuildState === 'failed' && (
            <form method="post" action={ADMIN_REBUILD_PATH}>
              <input type="hidden" name={CSRF_FORM_FIELD} value={access.access.csrfToken} />
              <input type="hidden" name="return_to" value={Astro.url.pathname} />
              <button class="kz-button kz-button--ghost" type="submit">Relancer le déploiement</button>
            </form>
          )}
        </>
      )
    )
  }
</AdminShell>
