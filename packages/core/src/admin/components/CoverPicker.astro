---
import { ADMIN_MEDIA_PATH } from '../../http/admin-routes.js';

/**
 * Sélecteur de couverture (mission §27/§32) — **HTML progressif** : un
 * `<select>` des médias `ready` (mission §29 : seuls les médias prêts sont
 * sélectionnables) + un `<option>` « Aucune » pour retirer la couverture.
 * Aperçu de la sélection courante rendu côté serveur ; le champ système
 * `cover_media_id` voyage hors de `data` (mission §27).
 *
 * Les médias en cours de traitement ou en échec sont visibles dans la
 * médiathèque (`{ADMIN_MEDIA_PATH}`) mais jamais proposés ici.
 */
interface Props {
  /** Médias `ready` (id + alt) — seuls sélectionnables. */
  readyMedia: ReadonlyArray<{ id: string; alt: string }>;
  /** Couverture courante (id éditorial) — sert l'aperçu et la valeur initiale. */
  selectedMediaId: string | null;
  /** Miniature de la couverture courante (serveur), ou `null`. */
  selectedThumbnailUrl: string | null;
  /** Erreur de champ (`errors.cover`). */
  error?: string;
}

const { readyMedia, selectedMediaId, selectedThumbnailUrl, error } = Astro.props;
---

<div class="kz-field kz-cover-field">
  <label class="kz-label" for="kz-cover">Image de couverture</label>
  <p class="kz-help">
    Optionnelle. Seuls les médias prêts sont proposés — gérez les images dans la{' '}
    <a class="kz-cover-field__link" href={ADMIN_MEDIA_PATH}>médiathèque</a>. La couverture est
    publiée avec le contenu (Save ≠ Publish).
  </p>
  {selectedThumbnailUrl && selectedMediaId && (
    <img
      class="kz-cover-field__preview"
      src={selectedThumbnailUrl}
      alt="Aperçu de la couverture actuelle"
      loading="lazy"
      decoding="async"
    />
  )}
  <select class="kz-input" id="kz-cover" name="cover_media_id">
    <option value="">Aucune</option>
    {
      readyMedia.map((media) => (
        <option value={media.id} selected={media.id === selectedMediaId}>
          {media.alt.length > 0 ? media.alt : `Image ${media.id.slice(0, 8)}`}
        </option>
      ))
    }
  </select>
  {error && <p class="kz-field-error" role="alert">{error}</p>}
</div>
