---
/**
 * Carte d'entrée fine (liée en entier) — même grammaire que les cartes
 * « papier » de la landing : bordure pierre, fond blanc, serif, flèche rouille.
 */
interface Props {
  href: string;
  title: string;
  text: string;
  meta?: string;
  /** Lien externe (GitHub) : ouvre dans un nouvel onglet, avec rel de sécurité. */
  external?: boolean;
}

const { href, title, text, meta, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="group block rounded-2xl border border-stone-300/70 bg-white p-7 transition-colors hover:border-ink md:p-8"
>
  {
    meta && (
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">{meta}</p>
    )
  }
  <p
    class={`flex items-baseline justify-between gap-4 font-display text-2xl font-medium tracking-tight text-ink ${meta ? 'mt-3' : ''}`}
  >
    {title}
    {external && <span class="sr-only"> (ouvre GitHub dans un nouvel onglet)</span>}
    <span aria-hidden="true" class="text-rust transition-transform group-hover:translate-x-1"
      >→</span
    >
  </p>
  <p class="mt-3 text-sm leading-relaxed text-stone-600">{text}</p>
</a>
