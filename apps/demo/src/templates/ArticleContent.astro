---
import type { ContentView } from '@kreiz/core/content';
import type { ArticleData } from '../content-types/article.js';
import '../styles/global.css';

/**
 * Template public de l'Article — **fourni par le projet**, rendu à
 * l'identique par la preview SSR du Core (`/admin/preview/[id]`) et par la
 * page publique `/articles/[slug]` (mission §21/§23). Le template reçoit
 * des données structurées typées, jamais du layout : toute la mise en page
 * appartient au projet (principe §1).
 */
interface Props {
  view: ContentView<ArticleData>;
}

const { view } = Astro.props;
const publishedDate = view.publishedAt
  ? view.publishedAt.toLocaleDateString('fr-FR', { dateStyle: 'long' })
  : null;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{view.seo.title ?? view.title} — Kreiz demo</title>
    {view.seo.description && <meta name="description" content={view.seo.description} />}
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
    <main class="mx-auto max-w-2xl px-6 py-20">
      <article>
        <header class="border-b border-neutral-800 pb-8">
          <p class="text-xs font-medium uppercase tracking-widest text-neutral-400">
            Article
            {!publishedDate && <span class="text-amber-400">— brouillon (preview)</span>}
          </p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight">{view.title}</h1>
          <p class="mt-4 text-lg leading-relaxed text-neutral-300">{view.data.excerpt}</p>
          <p class="mt-6 text-sm text-neutral-400">
            Par {view.data.author}{publishedDate ? ` · ${publishedDate}` : ''}
          </p>
        </header>

        <div class="mt-8 space-y-4 leading-relaxed text-neutral-200">
          {
            view.data.body
              .split(/\n\s*\n/)
              .map((paragraph) => <p>{paragraph}</p>)
          }
        </div>
      </article>

      <footer class="mt-16 border-t border-neutral-800 pt-6 text-sm text-neutral-500">
        <a href="/" class="transition hover:text-neutral-300">← Kreiz, application de démonstration</a>
      </footer>
    </main>
  </body>
</html>
