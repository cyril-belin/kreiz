---
import type { ContentView } from '@kreiz/core/content';
import type { CaseStudyData } from '../content-types/case-study.js';
import '../styles/global.css';

/**
 * Template public du Case Study — fourni par le projet, partagé entre la
 * preview SSR du Core et la page publique `/realisations/[slug]`. La liste
 * de métriques (`results`) est rendue en grille de chiffres clés : la
 * structure vient des données, la grille appartient au template.
 */
interface Props {
  view: ContentView<CaseStudyData>;
}

const { view } = Astro.props;
const categoryLabels: Record<CaseStudyData['category'], string> = {
  'site-vitrine': 'Site vitrine',
  'e-commerce': 'E-commerce',
  application: 'Application',
};
const publishedDate = view.publishedAt
  ? view.publishedAt.toLocaleDateString('fr-FR', { dateStyle: 'long' })
  : null;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{view.seo.title ?? view.title} — Kreiz demo</title>
    {view.seo.description && <meta name="description" content={view.seo.description} />}
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
    <main class="mx-auto max-w-3xl px-6 py-20">
      <article>
        <header class="border-b border-neutral-800 pb-8">
          <div class="flex items-center gap-3 text-xs font-medium uppercase tracking-widest text-neutral-400">
            <span>Réalisation</span>
            <span class="rounded-full border border-neutral-700 px-2.5 py-0.5 text-neutral-300">
              {categoryLabels[view.data.category]}
            </span>
            {!publishedDate && <span class="text-amber-400">brouillon (preview)</span>}
          </div>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight">{view.title}</h1>
          <p class="mt-4 text-lg leading-relaxed text-neutral-300">{view.data.shortDescription}</p>
          {publishedDate && <p class="mt-6 text-sm text-neutral-400">{publishedDate}</p>}
        </header>

        {
          view.data.results.length > 0 && (
            <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
              {view.data.results.map((result) => (
                <div class="rounded-lg border border-neutral-800 bg-neutral-900 p-4">
                  <dt class="text-xs font-medium uppercase tracking-wide text-neutral-400">
                    {result.label}
                  </dt>
                  <dd class="mt-1 text-2xl font-semibold tracking-tight">{result.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        <section class="mt-10">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-neutral-400">Contexte</h2>
          <div class="mt-3 space-y-4 leading-relaxed text-neutral-200">
            {
              view.data.context
                .split(/\n\s*\n/)
                .map((paragraph) => <p>{paragraph}</p>)
            }
          </div>
        </section>

        <section class="mt-10">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-neutral-400">Solution</h2>
          <div class="mt-3 space-y-4 leading-relaxed text-neutral-200">
            {
              view.data.solution
                .split(/\n\s*\n/)
                .map((paragraph) => <p>{paragraph}</p>)
            }
          </div>
        </section>
      </article>

      <footer class="mt-16 border-t border-neutral-800 pt-6 text-sm text-neutral-500">
        <a href="/" class="transition hover:text-neutral-300">← Kreiz, application de démonstration</a>
      </footer>
    </main>
  </body>
</html>
