---
import type { ContentView } from '@kreiz/core/content';
import {
  breadcrumbJsonLd,
  jsonLdScriptTag,
  resolveContentSeo,
  seoHeadTags,
  articleJsonLd,
} from '@kreiz/core/seo';
import type { GuideData } from '../content-types/guide.js';
import { seoSite } from '../seo.js';
import CoverPicture from './CoverPicture.astro';
import '../styles/global.css';

/**
 * Template public du Guide — fourni par le projet, partagé entre la preview
 * SSR du Core et la page publique `/guides/[slug]`. Le select fermé
 * `difficulty` est rendu en badge : la valeur stockée est du sens, la
 * présentation appartient au template.
 *
 * Slice 9 : head SEO résolue et rendue par le Core (même contrat que
 * l'Article — `resolveContentSeo` + `seoHeadTags` + JSON-LD typé).
 */
interface Props {
  view: ContentView<GuideData>;
}

const { view } = Astro.props;
const difficultyLabels: Record<GuideData['difficulty'], string> = {
  debutant: 'Débutant',
  intermediaire: 'Intermédiaire',
  avance: 'Avancé',
};
const resolvedSeo = resolveContentSeo(seoSite, view, {
  ogType: 'article',
  description: view.data.excerpt,
});
const articleLd = articleJsonLd({
  headline: view.title,
  url: resolvedSeo.canonical,
  datePublished: view.publishedAt ?? view.createdAt,
  description: resolvedSeo.description,
  imageUrl: resolvedSeo.og.image?.url,
  publisherName: seoSite.organization?.name ?? seoSite.siteName,
});
const breadcrumbLd = breadcrumbJsonLd([
  { name: seoSite.siteName, url: `${seoSite.siteUrl}/` },
  { name: view.title, url: resolvedSeo.canonical },
]);
const publishedDate = view.publishedAt
  ? view.publishedAt.toLocaleDateString('fr-FR', { dateStyle: 'long' })
  : null;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={seoHeadTags(resolvedSeo)} />
    <Fragment set:html={jsonLdScriptTag(articleLd)} />
    <Fragment set:html={jsonLdScriptTag(breadcrumbLd)} />
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
    <main class="mx-auto max-w-2xl px-6 py-20">
      <article>
        <header class="border-b border-neutral-800 pb-8">
          <div class="flex items-center gap-3 text-xs font-medium uppercase tracking-widest text-neutral-400">
            <span>Guide</span>
            <span class="rounded-full border border-neutral-700 px-2.5 py-0.5 text-neutral-300">
              {difficultyLabels[view.data.difficulty]}
            </span>
            {!publishedDate && <span class="text-amber-400">brouillon (preview)</span>}
          </div>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight">{view.title}</h1>
          <p class="mt-4 text-lg leading-relaxed text-neutral-300">{view.data.excerpt}</p>
          {publishedDate && <p class="mt-6 text-sm text-neutral-400">{publishedDate}</p>}
        </header>

        {view.cover && <CoverPicture cover={view.cover} />}

        {/* Rich text (slice 6) — même contrat que l'article : source unique
        = renderer déterministe du Core. */}
        <div class="mt-8 space-y-4 leading-relaxed text-neutral-200" set:html={view.richText.body?.html} />
      </article>

      <footer class="mt-16 border-t border-neutral-800 pt-6 text-sm text-neutral-500">
        <a href="/" class="transition hover:text-neutral-300">← Kreiz, application de démonstration</a>
      </footer>
    </main>
  </body>
</html>
