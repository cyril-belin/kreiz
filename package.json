{
  "name": "kreiz",
  "private": true,
  "type": "module",
  "description": "Open-source editorial core for Astro",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyril-belin/kreiz.git"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run packages/core/tests/integration",
    "test:e2e": "pnpm --filter @kreiz/demo test:e2e",
    "db:generate": "pnpm --filter @kreiz/demo db:generate",
    "db:migrate": "pnpm --filter @kreiz/demo db:migrate"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
