---
export const prerender = false;

import AdminShell from '../components/AdminShell.astro';
import { ADMIN_LOGIN_PATH } from '../../http/admin-routes.js';
import { authenticateContentPage } from '../lib/content-page.js';

// Guard + en-têtes de sécurité + rafraîchissement du cookie — socle commun
// des pages admin (slice 2, réutilisé tel quel par le moteur de contenu).
const access = await authenticateContentPage(Astro);
if (access.kind === 'unauthenticated') {
  return Astro.redirect(ADMIN_LOGIN_PATH, 302);
}
---

<AdminShell
  title="Dashboard"
  admin={access.access.admin}
  csrfToken={access.access.csrfToken}
  currentPath={Astro.url.pathname}
>
  <section class="kz-panel" aria-labelledby="kz-welcome-title">
    <h2 class="kz-panel__title" id="kz-welcome-title">
      Bienvenue, {access.access.admin.name}
    </h2>
    <p class="kz-panel__text">
      Vous êtes authentifié·e. Gérez les contenus déclarés par le projet depuis
      la section « Contenu » ; les modules médias, formulaires et analytics
      arrivent dans les prochains slices.
    </p>
    <dl>
      <dt>Session</dt>
      <dd>
        active — expiration glissante le{' '}
        {access.access.session.expiresAt.toLocaleString('fr-FR')}
      </dd>
      <dt>Limite absolue</dt>
      <dd>{access.access.session.absoluteExpiresAt.toLocaleDateString('fr-FR')}</dd>
    </dl>
  </section>
</AdminShell>
