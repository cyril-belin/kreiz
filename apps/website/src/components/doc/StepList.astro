---
/**
 * Liste d'étapes éditoriale : numérotation decimal-leading-zero en serif
 * rouille, filets fins entre les étapes. Les enfants directs `<li>` sont
 * écrits par les pages (`<h3>` titre, `<p>` corps, blocs/callouts autorisés).
 */
---

<ol class="doc-steps mt-10">
  <slot />
</ol>

<style is:global>
  .doc-steps {
    counter-reset: doc-step;
  }
  .doc-steps > li {
    counter-increment: doc-step;
    position: relative;
    padding: 2rem 0 2rem 4.25rem;
    border-top: 1px solid rgb(214 211 209 / 0.6);
  }
  .doc-steps > li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .doc-steps > li::before {
    content: counter(doc-step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 2rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-rust);
  }
  .doc-steps > li:first-child::before {
    top: 0.125rem;
  }
  .doc-steps > li > h3 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .doc-steps > li > p {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-stone-600);
  }
  .doc-steps > li > p + p {
    margin-top: 0.6rem;
  }
  @media (max-width: 480px) {
    .doc-steps > li {
      padding-left: 3.25rem;
    }
    .doc-steps > li::before {
      font-size: 1.25rem;
    }
  }
</style>
