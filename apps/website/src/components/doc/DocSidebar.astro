---
/**
 * Sommaire de la documentation : colonne latérale sticky sur desktop,
 * accordéon natif `<details>` sur mobile (zéro JavaScript). La page courante
 * est marquée en rouille avec `aria-current="page"`.
 */
import { docNavGroups } from '../../lib/doc-nav';
import { siteUrl } from '../../lib/urls';

interface Props {
  current: string;
}

const { current } = Astro.props;
const linkClass = (id: string): string =>
  id === current
    ? 'font-medium text-rust'
    : 'text-stone-600 transition-colors hover:text-ink';
---

<nav class="lg:hidden" aria-label="Sommaire de la documentation">
  <details class="group rounded-2xl border border-stone-300/70 bg-white">
    <summary
      class="flex cursor-pointer list-none items-center justify-between px-6 py-4 [&::-webkit-details-marker]:hidden"
    >
      <span class="text-sm font-medium text-ink">Sommaire de la documentation</span>
      <span aria-hidden="true" class="text-rust transition-transform group-open:rotate-180">▾</span>
    </summary>
    <div class="space-y-6 border-t border-stone-200 px-6 pb-6 pt-5">
      {
        docNavGroups.map((group) => (
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">
              {group.title}
            </p>
            <ul class="mt-3 space-y-2.5 text-sm">
              {group.pages.map((page) => (
                <li>
                  <a
                    href={siteUrl(page.href)}
                    class={linkClass(page.id)}
                    aria-current={page.id === current ? 'page' : undefined}
                  >
                    {page.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </details>
</nav>

<nav class="hidden lg:block" aria-label="Sommaire de la documentation">
  <div class="sticky top-10 space-y-8">
    {
      docNavGroups.map((group) => (
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">
            {group.title}
          </p>
          <ul class="mt-3 space-y-2.5 text-sm">
            {group.pages.map((page) => (
              <li>
                <a
                  href={siteUrl(page.href)}
                  class={linkClass(page.id)}
                  aria-current={page.id === current ? 'page' : undefined}
                >
                  {page.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</nav>
